{
  "expo": {
    "name": "SpaceCraft 3D",
    "slug": "spacecraft-3d-designer-vzczux",
    "version": "1.0.2",
    "description": "Design beautiful 2D and 3D floor plans. Furnish your space with 500+ furniture items, use AI to generate room layouts, and visualize in stunning 3D.",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon-frq.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/app-icon-frq.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0E1A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spacecraft.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "SpaceCraft 3D uses your camera to place furniture in your real room using AR.",
        "NSPhotoLibraryUsageDescription": "SpaceCraft 3D saves floor plan exports and design images to your photo library."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon-frq.png",
        "backgroundColor": "#0A0E1A"
      },
      "package": "com.spacecraft.app",
      "versionCode": 3,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.VIBRATE",
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "favicon": "./assets/images/newly.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-web-browser",
      "expo-secure-store",
      "expo-camera",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow SpaceCraft 3D to save floor plan exports to your photo library."
        }
      ]
    ],
    "scheme": "spacecraft3d",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {}
    }
  }
}